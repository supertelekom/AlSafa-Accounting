<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/alsafa_cream"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layoutDirection="rtl" android:padding="15dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical"><Button android:id="@+id/pageBack" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="‹ رجوع" android:background="@drawable/alsafa_card"/><Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="مبيع" android:textSize="24sp" android:textStyle="bold" android:textColor="@color/alsafa_ink"/></LinearLayout>
<TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ابحث عن الساعة ثم اخترها" android:gravity="end" android:textColor="@color/alsafa_muted" android:padding="8dp"/>
<EditText android:id="@+id/saleSearch" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="اسم الساعة أو الباركود"/><Button android:id="@+id/searchSaleProduct" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="بحث"/><LinearLayout android:id="@+id/saleSearchResults" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/><TextView android:id="@+id/saleSelectedProduct" android:layout_width="match_parent" android:layout_height="wrap_content"/><EditText android:id="@+id/saleProductId" android:layout_width="match_parent" android:layout_height="1dp" android:visibility="gone"/><EditText android:id="@+id/saleQuantity" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="الكمية" android:inputType="number"/><Spinner android:id="@+id/saleCurrency" android:layout_width="match_parent" android:layout_height="wrap_content"/><LinearLayout android:id="@+id/salePaymentRows" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/><Button android:id="@+id/addSalePayment" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="+ إضافة طريقة دفع أخرى"/><Button android:id="@+id/saveSale" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="تثبيت المبيع"/>
<!-- Optional ids used defensively by the shared binder. -->
<Button android:id="@+id/openWorkDay" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone"/><Button android:id="@+id/useLatestCarry" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone"/><Button android:id="@+id/closeWorkDay" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone"/>
</LinearLayout></ScrollView>