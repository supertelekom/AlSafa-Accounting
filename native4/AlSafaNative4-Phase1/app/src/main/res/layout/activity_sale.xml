<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/alsafa_cream"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layoutDirection="rtl" android:padding="15dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical"><Button android:id="@+id/pageBack" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="‹ رجوع" android:background="@drawable/alsafa_card"/><Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🛒 المبيع" android:textSize="24sp" android:textStyle="bold" android:textColor="@color/alsafa_ink"/></LinearLayout>
<TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="فاتورة مبيع جديدة" android:gravity="end" android:textColor="@color/alsafa_muted" android:padding="8dp"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp" android:background="@drawable/alsafa_card"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="👤 العميل والولاء" android:textSize="19sp" android:textStyle="bold" android:gravity="end"/><EditText android:id="@+id/saleCustomerSearch" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="اسم العميل أو رقم الهاتف"/><EditText android:id="@+id/saleCustomerId" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone"/><TextView android:id="@+id/saleSelectedCustomer" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="بدون عميل محدد" android:gravity="end" android:padding="8dp"/><LinearLayout android:id="@+id/saleCustomerResults" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/><EditText android:id="@+id/salePointsUsed" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="استخدام نقاط العميل" android:inputType="number"/></LinearLayout>
<Space android:layout_width="1dp" android:layout_height="10dp"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp" android:background="@drawable/alsafa_card"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="⌚ الساعة والكمية" android:textSize="19sp" android:textStyle="bold" android:gravity="end"/><EditText android:id="@+id/saleSearch" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="اسم الساعة أو الباركود"/><Button android:id="@+id/searchSaleProduct" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="⌕ بحث عن المنتج"/><LinearLayout android:id="@+id/saleSearchResults" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/><TextView android:id="@+id/saleSelectedProduct" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="end"/><EditText android:id="@+id/saleProductId" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone"/><EditText android:id="@+id/saleQuantity" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="الكمية" android:inputType="number"/><Button android:id="@+id/addSaleItem" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="+ إضافة الساعة إلى الفاتورة"/><Button android:id="@+id/addManualSaleItem" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="+ إضافة صنف يدوي"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="🧾 أصناف الفاتورة" android:textSize="18sp" android:textStyle="bold" android:gravity="end" android:paddingTop="10dp"/><LinearLayout android:id="@+id/saleItems" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/></LinearLayout>
<Space android:layout_width="1dp" android:layout_height="10dp"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp" android:background="@drawable/alsafa_card"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="💰 تفاصيل الفاتورة والسعر" android:textSize="19sp" android:textStyle="bold" android:gravity="end"/><Spinner android:id="@+id/saleChannel" android:layout_width="match_parent" android:layout_height="wrap_content"/><Spinner android:id="@+id/saleCurrency" android:layout_width="match_parent" android:layout_height="wrap_content"/><EditText android:id="@+id/saleDiscount" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="الخصم على الفاتورة" android:inputType="numberDecimal"/><EditText android:id="@+id/saleTax" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="الضريبة" android:inputType="numberDecimal"/><EditText android:id="@+id/saleFinalAmount" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="السعر النهائي بعد المفاصلة (اختياري)" android:inputType="numberDecimal"/><EditText android:id="@+id/saleAdjustmentReason" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="سبب تعديل السعر عند استخدام السعر النهائي"/><EditText android:id="@+id/saleWarranty" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="الضمان"/><EditText android:id="@+id/saleNotes" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="ملاحظات الفاتورة" android:minLines="2"/></LinearLayout>
<Space android:layout_width="1dp" android:layout_height="10dp"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp" android:background="@drawable/alsafa_card"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="💳 التحصيل والدفعات" android:textSize="19sp" android:textStyle="bold" android:gravity="end"/><CheckBox android:id="@+id/saleAllowDue" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="بيع آجل / السماح بباقي مستحق" android:gravity="end"/><LinearLayout android:id="@+id/salePaymentRows" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/><Button android:id="@+id/addSalePayment" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="+ إضافة دفعة أخرى"/></LinearLayout>
<Space android:layout_width="1dp" android:layout_height="12dp"/><Button android:id="@+id/saveSale" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp" android:text="✓ حفظ وتثبيت المبيع" android:background="@drawable/alsafa_primary"/>
<Button android:id="@+id/openWorkDay" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone"/><Button android:id="@+id/useLatestCarry" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone"/><Button android:id="@+id/closeWorkDay" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><Button android:id="@+id/navHome" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="⌂ الرئيسية"/><Button android:id="@+id/navSale" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="🛒 مبيع"/><Button android:id="@+id/navRepair" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="🔧 صيانة"/><Button android:id="@+id/navSearch" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="⌕ بحث"/><Button android:id="@+id/navMore" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="☰ المزيد"/></LinearLayout></LinearLayout></ScrollView>