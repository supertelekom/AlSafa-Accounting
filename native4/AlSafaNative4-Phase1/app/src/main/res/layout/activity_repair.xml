<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/alsafa_cream"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layoutDirection="rtl" android:padding="15dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical"><Button android:id="@+id/pageBack" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="‹ رجوع" android:background="@drawable/alsafa_card"/><Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🔧 الصيانة" android:textSize="24sp" android:textStyle="bold" android:textColor="@color/alsafa_ink"/></LinearLayout>
<TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="استلام صيانة جديدة" android:gravity="end" android:textColor="@color/alsafa_muted" android:padding="8dp"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp" android:background="@drawable/alsafa_card"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="👤 بيانات العميل" android:textSize="19sp" android:textStyle="bold" android:gravity="end"/><EditText android:id="@+id/repairCustomer" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="اسم العميل"/><EditText android:id="@+id/repairPhone" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="رقم هاتف العميل" android:inputType="phone"/></LinearLayout>
<Space android:layout_width="1dp" android:layout_height="10dp"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp" android:background="@drawable/alsafa_card"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="⌚ الساعة والعطل" android:textSize="19sp" android:textStyle="bold" android:gravity="end"/><EditText android:id="@+id/repairWatch" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="وصف الساعة / العطل / المطلوب"/></LinearLayout>
<Space android:layout_width="1dp" android:layout_height="10dp"/><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp" android:background="@drawable/alsafa_card"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="🔧 قطع الصيانة" android:textSize="19sp" android:textStyle="bold" android:gravity="end"/><LinearLayout android:id="@+id/repairPartRows" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/><Button android:id="@+id/addRepairPart" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="+ إضافة قطعة صيانة"/></LinearLayout>
<Space android:layout_width="1dp" android:layout_height="10dp"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp" android:background="@drawable/alsafa_card"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="💰 السعر والتحصيل" android:textSize="19sp" android:textStyle="bold" android:gravity="end"/><EditText android:id="@+id/repairTotal" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="المبلغ المتفق عليه" android:inputType="numberDecimal"/><Spinner android:id="@+id/repairCurrency" android:layout_width="match_parent" android:layout_height="wrap_content"/><Spinner android:id="@+id/repairAccount" android:layout_width="match_parent" android:layout_height="wrap_content"/></LinearLayout>
<Space android:layout_width="1dp" android:layout_height="12dp"/><Button android:id="@+id/saveRepair" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp" android:text="✓ حفظ واستلام الصيانة" android:background="@drawable/alsafa_primary"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><Button android:id="@+id/navHome" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="⌂ الرئيسية"/><Button android:id="@+id/navSale" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="🛒 مبيع"/><Button android:id="@+id/navRepair" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="🔧 صيانة"/><Button android:id="@+id/navSearch" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="⌕ بحث"/><Button android:id="@+id/navMore" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="☰ المزيد"/></LinearLayout></LinearLayout></ScrollView>