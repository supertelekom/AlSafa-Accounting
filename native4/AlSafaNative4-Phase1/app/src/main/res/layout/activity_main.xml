<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/rootContent" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/alsafa_cream"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layoutDirection="rtl" android:padding="16dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp" android:background="@drawable/alsafa_card"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="🛡️ حماية المخزون مفعّلة" android:textStyle="bold" android:gravity="end"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="لا حذف تلقائي من Firebase أو المزامنة أو الاستيراد" android:gravity="end"/></LinearLayout>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ALSAFA WATCHES" android:textColor="@color/alsafa_gold" android:textStyle="bold" android:gravity="end" android:paddingTop="24dp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="كيف تريد أن تبدأ؟" android:textColor="@color/alsafa_ink" android:textSize="28sp" android:textStyle="bold" android:gravity="end"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="اختر بيئة العمل المناسبة، أو افتح مستشار اختيار الساعة أمام العميل." android:textColor="@color/alsafa_muted" android:textSize="16sp" android:gravity="end" android:paddingBottom="12dp"/>
