<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" android:gravity="end">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="الصفا Native 4 — Firebase Test" android:textSize="24sp" android:textStyle="bold" android:gravity="end"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="معزول على com.alsafa.native4.test ومتجر test-native4 فقط. بيانات الدخول لا تُحفظ في السورس." android:textSize="15sp" android:gravity="end" android:layout_marginTop="8dp"/>
<TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="جاهز" android:textSize="17sp" android:gravity="end" android:layout_marginTop="20dp"/>
<TextView android:id="@+id/authStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Firebase Auth: غير مسجل" android:textSize="15sp" android:gravity="end" android:layout_marginTop="12dp"/>
<EditText android:id="@+id/authEmail" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="بريد مستخدم الاختبار" android:inputType="textEmailAddress" android:gravity="end"/>
<EditText android:id="@+id/authPassword" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="كلمة المرور" android:inputType="textPassword" android:gravity="end"/>
<Button android:id="@+id/signIn" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="تسجيل الدخول إلى Firebase التجريبي"/>
<Button android:id="@+id/signOut" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="تسجيل الخروج"/>
<Button android:id="@+id/sendOutbox" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="إرسال Outbox إلى test-native4"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="إضافة منتج تجريبي" android:textSize="19sp" android:textStyle="bold" android:gravity="end" android:layout_marginTop="22dp"/>
<EditText android:id="@+id/productName" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="اسم المنتج" android:gravity="end"/><EditText android:id="@+id/productQuantity" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="الكمية" android:inputType="number" android:gravity="end"/><EditText android:id="@+id/productPrice" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="السعر" android:inputType="numberDecimal" android:gravity="end"/><Button android:id="@+id/saveProduct" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="حفظ المنتج محلياً"/><TextView android:id="@+id/products" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp" android:gravity="end" android:layout_marginTop="14dp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="تسجيل بيع تجريبي" android:textSize="19sp" android:textStyle="bold" android:gravity="end" android:layout_marginTop="22dp"/><EditText android:id="@+id/saleProductId" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="معرّف المنتج" android:gravity="end"/><EditText android:id="@+id/saleQuantity" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="الكمية المباعة" android:inputType="number" android:gravity="end"/><EditText android:id="@+id/salePayment" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="CASH أو SHAM_CASH أو LATER" android:gravity="end"/><Button android:id="@+id/saveSale" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="تثبيت الفاتورة + حفظ Outbox"/><TextView android:id="@+id/sales" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp" android:gravity="end" android:layout_marginTop="14dp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Outbox التجريبي" android:textSize="19sp" android:textStyle="bold" android:gravity="end" android:layout_marginTop="22dp"/><TextView android:id="@+id/outbox" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:gravity="end" android:layout_marginTop="8dp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="تسجيل صيانة تجريبية" android:textSize="19sp" android:textStyle="bold" android:gravity="end" android:layout_marginTop="22dp"/><EditText android:id="@+id/repairCustomer" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="اسم العميل" android:gravity="end"/><EditText android:id="@+id/repairWatch" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="وصف الساعة" android:gravity="end"/><EditText android:id="@+id/repairTotal" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="قيمة الصيانة" android:inputType="numberDecimal" android:gravity="end"/><EditText android:id="@+id/repairPayment" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="طريقة الدفع" android:gravity="end"/><Button android:id="@+id/saveRepair" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="تثبيت الصيانة محلياً"/><TextView android:id="@+id/repairs" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp" android:gravity="end" android:layout_marginTop="14dp"/>
</LinearLayout></ScrollView>
