<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="عمل اليوم" android:textSize="20sp" android:textStyle="bold" android:textColor="@color/alsafa_ink" android:gravity="end" android:paddingTop="14dp" android:paddingBottom="6dp"/><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp"><Button android:id="@+id/openHandover" android:layout_width="0dp" android:layout_height="76dp" android:layout_weight="1" android:text="⌚ تسليم الساعات&#10;تحصيل وتسليم" android:background="@drawable/alsafa_card"/><Button android:id="@+id/openSearch" android:layout_width="0dp" android:layout_height="76dp" android:layout_weight="1" android:text="🔎 بحث&#10;اسم أو باركود" android:background="@drawable/alsafa_card"/></LinearLayout><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="الإدارة والمخزون" android:textSize="20sp" android:textStyle="bold" android:textColor="@color/alsafa_ink" android:gravity="end" android:paddingTop="14dp" android:paddingBottom="6dp"/><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp"><Button android:id="@+id/openProducts" android:layout_width="0dp" android:layout_height="72dp" android:layout_weight="1" android:text="⌚  المنتجات" android:background="@drawable/alsafa_card"/><Button android:id="@+id/openPurchases" android:layout_width="0dp" android:layout_height="72dp" android:layout_weight="1" android:text="📦  المشتريات" android:background="@drawable/alsafa_card"/></LinearLayout>
