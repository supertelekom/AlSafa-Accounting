<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="المبيع والصيانة" android:textSize="20sp" android:textStyle="bold" android:textColor="@color/alsafa_ink" android:gravity="end" android:paddingTop="18dp" android:paddingBottom="8dp"/>
