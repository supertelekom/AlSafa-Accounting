<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/alsafa_cream" android:fillViewport="true"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layoutDirection="rtl" android:padding="16dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical"><Button android:id="@+id/pageBack" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="‹ رجوع" android:background="@drawable/alsafa_card"/><Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/><LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="الوضع الكامل" android:textSize="28sp" android:textStyle="bold" android:textColor="@color/alsafa_ink"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="المبيع • الصيانة • المخزون • الصناديق • التقارير" android:textColor="@color/alsafa_muted"/></LinearLayout></LinearLayout>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ALSAFA WATCHES" android:textColor="@color/alsafa_gold" android:textStyle="bold" android:gravity="end" android:paddingTop="12dp" android:paddingBottom="6dp"/>
