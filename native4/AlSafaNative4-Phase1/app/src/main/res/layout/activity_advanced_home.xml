<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp"><Button android:id="@+id/openCash" android:layout_width="0dp" android:layout_height="72dp" android:layout_weight="1" android:text="💰  الصناديق" android:background="@drawable/alsafa_card"/><Button android:id="@+id/openClosing" android:layout_width="0dp" android:layout_height="72dp" android:layout_weight="1" android:text="🌙  الإقفال اليومي" android:background="@drawable/alsafa_card"/></LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp"><Button android:id="@+id/openReports" android:layout_width="0dp" android:layout_height="72dp" android:layout_weight="1" android:text="📊  التقارير" android:background="@drawable/alsafa_card"/><Button android:id="@+id/openSettings" android:layout_width="0dp" android:layout_height="72dp" android:layout_weight="1" android:text="⚙️  الإعدادات" android:background="@drawable/alsafa_card"/></LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp"><Button android:id="@+id/navHome" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="⌂ الرئيسية"/><Button android:id="@+id/navSale" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="🛒 مبيع"/><Button android:id="@+id/navRepair" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="🔧 صيانة"/><Button android:id="@+id/navSearch" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="⌕ بحث"/><Button android:id="@+id/navMore" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="☰ المزيد"/></LinearLayout>
