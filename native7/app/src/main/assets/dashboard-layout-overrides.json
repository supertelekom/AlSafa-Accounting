{
  "schemaVersion": 1,
  "description": "Native7 presentation overlays for source-derived pages. Source labels and element order remain unchanged; tablet rules apply only to listed routes.",
  "routes": [
    "home",
    "dashboard",
    "father-home",
    "advanced-home",
    "simple-home",
    "more"
  ],
  "fontAsset": "Tajawal-Medium.ttf",
  "rtl": true,
  "tabletMinWidthDp": 600,
  "targets": [
    {
      "classes": [
        "mode-main-grid",
        "modern-shortcuts-grid",
        "father-main-actions",
        "simple-actions",
        "modern-feature-grid"
      ],
      "gapDp": 14,
      "marginBottomDp": 18
    },
    {
      "classes": [
        "mode-card",
        "modern-shortcut",
        "father-main-card",
        "modern-feature-card",
        "simple-action"
      ],
      "paddingDp": 18,
      "cornerRadiusDp": 18,
      "minHeightDp": 76
    },
    {
      "classes": [
        "page-heading",
        "father-head",
        "simple-home-head"
      ],
      "marginBottomDp": 16
    }
  ],
  "routeOverrides": {
    "dashboard": {
      "targets": [
        {
          "kinds": [
            "button"
          ],
          "classes": [
            "mode-card",
            "modern-feature-card",
            "father-main-card",
            "simple-action"
          ],
          "paddingDp": 18,
          "cornerRadiusDp": 18,
          "minHeightDp": 76
        }
      ]
    },
    "father-home": {
      "targets": [
        {
          "kinds": [
            "button"
          ],
          "classes": [
            "mode-card",
            "modern-feature-card",
            "father-main-card",
            "simple-action"
          ],
          "paddingDp": 18,
          "cornerRadiusDp": 18,
          "minHeightDp": 76
        }
      ]
    },
    "advanced-home": {
      "targets": [
        {
          "kinds": [
            "button"
          ],
          "classes": [
            "mode-card",
            "modern-feature-card",
            "father-main-card",
            "simple-action"
          ],
          "paddingDp": 18,
          "cornerRadiusDp": 18,
          "minHeightDp": 76
        }
      ]
    }
  }
}
